<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/live_workout_widget_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_liftlog_mark"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/widget_workout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/app_name"
            android:textColor="#F5F5EF"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_workout_widget_ready"
            android:textColor="#D5FF3F"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:textSize="9sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/widget_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <Chronometer
                android:id="@+id/widget_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F5F5EF"
                android:textSize="36sp"
                android:fontFamily="sans-serif-light"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:singleLine="true" />
        </LinearLayout>
        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/live_workout_widget_idle"
            android:textColor="#F5F5EF"
            android:fontFamily="sans-serif-medium"
            android:textSize="21sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/widget_exercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/live_workout_widget_idle_detail"
            android:textColor="#A8ACA0"
            android:fontFamily="sans-serif"
            android:textSize="13sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="2dp"
        android:progressDrawable="@drawable/live_workout_widget_progress"
        android:indeterminate="false"
        android:indeterminateOnly="false"
        android:minHeight="3dp"
        android:maxHeight="3dp"
        android:max="1"
        android:progress="0"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="23dp"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textColor="#A8ACA0"
            android:fontFamily="sans-serif"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="invisible" />
        <TextView
            android:id="@+id/widget_cta"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/live_workout_widget_open"
            android:textColor="#D5FF3F"
            android:fontFamily="sans-serif-medium"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
    </LinearLayout>
</LinearLayout>
